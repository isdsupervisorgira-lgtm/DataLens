@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-1">AQI Dashboard</h1>
    <p class="text-muted mb-4">Station 34 &nbsp;·&nbsp; Real-time averages</p>


    <div class="row g-3 mb-5">

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-danger me-2">CO</span>
                        <small class="text-muted">Carbon Monoxide</small>
                    </div>
                    <h2 class="fw-bold text-danger">@String.Format("{0:F2}", ViewBag.AvgCO)</h2>
                    <small class="text-muted">mg/m³ — Average</small>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-warning text-dark me-2">SO₂</span>
                        <small class="text-muted">Sulphur Dioxide</small>
                    </div>
                    <h2 class="fw-bold text-warning">@String.Format("{0:F2}", ViewBag.AvgSO2)</h2>
                    <small class="text-muted">µg/m³ — Average</small>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-info text-dark me-2">NOx</span>
                        <small class="text-muted">Nitrogen Oxides</small>
                    </div>
                    <h2 class="fw-bold text-info">@String.Format("{0:F2}", ViewBag.AvgNOx)</h2>
                    <small class="text-muted">µg/m³ — Average</small>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-primary me-2">PM2.5</span>
                        <small class="text-muted">Fine Particles</small>
                    </div>
                    <h2 class="fw-bold text-primary">@String.Format("{0:F2}", ViewBag.AvgPM25)</h2>
                    <small class="text-muted">µg/m³ — Average</small>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-success me-2">PM10</span>
                        <small class="text-muted">Coarse Particles</small>
                    </div>
                    <h2 class="fw-bold text-success">@String.Format("{0:F2}", ViewBag.AvgPM10)</h2>
                    <small class="text-muted">µg/m³ — Average</small>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-secondary me-2">Temp</span>
                        <small class="text-muted">Ambient Temperature</small>
                    </div>
                    <h2 class="fw-bold text-secondary">@String.Format("{0:F2}", ViewBag.AvgTemp)</h2>
                    <small class="text-muted">°C — Average</small>
                </div>
            </div>
        </div>

    </div>
    </div>




